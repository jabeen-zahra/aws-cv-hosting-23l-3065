{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3065/site/*"
    },
    {
      "Sid": "ListWithPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3065",
      "Condition": {
        "StringLike": { "s3:prefix": "site/*" }
      }
    }
  ]
}